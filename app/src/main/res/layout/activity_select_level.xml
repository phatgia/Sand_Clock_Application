<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SelectLevel"
    android:background="@mipmap/bg">


    <Button
        android:id="@+id/btnPlayLevel1"
        android:layout_width="wrap_content"
        android:layout_height="85dp"
        android:layout_marginStart="108dp"
        android:layout_marginTop="58dp"
        android:layout_marginEnd="108dp"
        android:layout_marginBottom="80dp"
        android:backgroundTint="@android:color/holo_green_light"
        android:text="Level 1"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textStyle="bold"
        app:icon="@drawable/play_arrow_24px"
        app:iconSize="30sp"
        app:iconTint="@color/black"
        app:layout_constraintBottom_toTopOf="@+id/btnPlayLevel2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.488"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/game_view" />

    <Button
        android:id="@+id/btnBack2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="44dp"
        android:backgroundTint="@color/material_dynamic_neutral_variant10"
        app:icon="@drawable/arrow_back_ios_24px"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnPlayLevel3"
        android:layout_width="wrap_content"
        android:layout_height="85dp"
        android:layout_marginStart="108dp"
        android:layout_marginEnd="108dp"
        android:layout_marginBottom="220dp"
        android:backgroundTint="@android:color/holo_green_light"
        android:text="Level 3"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textStyle="bold"
        app:icon="@drawable/play_arrow_24px"
        app:iconSize="30sp"
        app:iconTint="@color/black"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.488"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btnPlayLevel2"
        android:layout_width="wrap_content"
        android:layout_height="85dp"
        android:layout_marginStart="108dp"
        android:layout_marginEnd="108dp"
        android:layout_marginBottom="72dp"
        android:backgroundTint="@android:color/holo_green_light"
        android:text="Level 2"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textStyle="bold"
        app:icon="@drawable/play_arrow_24px"
        app:iconSize="30sp"
        app:iconTint="@color/black"
        app:layout_constraintBottom_toTopOf="@+id/btnPlayLevel3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.488"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>